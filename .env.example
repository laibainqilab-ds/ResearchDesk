# PostgreSQL connection (application data: users, chats, messages, documents, runs)
DATABASE_URL=postgresql://researchdesk_app:CHANGE_ME@127.0.0.1:5432/researchdesk

# Gemini API key, used for RAG/agent answer generation. Required -- the
# generator raises at call time if this is unset.
GEMINI_API_KEY=CHANGE_ME

# Gemini model name. Optional -- defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# Secret key for signing API bearer tokens. Auto-generated into .env on first
# run if left unset -- only set this explicitly if you need a stable value
# across environments.
JWT_SECRET=CHANGE_ME

# Base URL the Streamlit frontend uses to reach the FastAPI backend.
API_BASE_URL=http://127.0.0.1:8000
